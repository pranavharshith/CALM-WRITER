# CALM-WRITER Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=UTC

# Database
MONGO_URL=mongodb://127.0.0.1:27017/calmstories
MONGODB_URI=mongodb://127.0.0.1:27017/calmstories
MONGODB_POOL_SIZE=10
MONGODB_POOL_MIN_SIZE=2

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=calmstories

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=CALM Writer <your-email@gmail.com>

# Security Secrets (GENERATE NEW VALUES FOR PRODUCTION!)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=generate-a-secure-random-string-at-least-32-chars
JWT_SECRET=generate-a-different-secure-random-string-32-chars
JWT_REFRESH_SECRET=generate-another-different-secure-random-string-32-chars

# JWT Configuration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=10

# Feature Configuration
STORY_COOLDOWN_HOURS=12
STORY_MAX_WORDS=800
STORY_MIN_LENGTH=10
OTP_EXPIRY_MINUTES=15
ACCOUNT_LOCKOUT_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION_HOURS=1

# Frontend URL (comma-separated for multiple origins in production)
FRONTEND_URL=http://localhost:3000

# Redis Configuration (optional, for distributed rate limiting)
# REDIS_URL=redis://localhost:6379

# Upstash Redis Configuration (alternative to REDIS_URL for cloud-based rate limiting)
# Get these from your Upstash dashboard
# UPSTASH_REDIS_REST_URL=https://your-region-your-id.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# Production Configuration (uncomment and configure for production)
# NODE_ENV=production
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/calmstories
# FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com
# MINIO_ENDPOINT=your-minio-endpoint.com
# MINIO_USE_SSL=true
# TRUST_PROXY=true
# REDIS_URL=redis://your-redis-endpoint:6379
# OR use Upstash:
# UPSTASH_REDIS_REST_URL=https://your-region-your-id.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
